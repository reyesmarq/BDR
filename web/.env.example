# Clerk publishable key for this instance (safe to expose to the browser)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""

# Clerk secret key (server-side only, never expose to the browser)
CLERK_SECRET_KEY=""

# Base URL of the NestJS API (the Render backend, or http://localhost:8000 locally)
NEXT_PUBLIC_API_URL="http://localhost:8000"
